<%- include('../partials/header') %>

<div class="container">
    <a href="/posts/new" class="btn">Nuevo Post</a>
    <% posts.forEach(post => { %>
        <article class="post">
            <h2><%= post.title %></h2>
            <p><em>Publicado el: <%= new Date(post.date).toLocaleDateString() %></em></p>
            <p><%= post.content.substring(0, 200) %>...</p>
            <a href="/posts/<%= post.id %>" class="btn">Leer Más</a>
        </article>
    <% }) %>
</div>

<%- include('../partials/footer') %>
