<%- include('../partials/header') %>

<div class="container">
    <article class="post">
        <h2><%= post.title %></h2>
        <p><em>Publicado el: <%= new Date(post.date).toLocaleDateString() %></em></p>
        <div><%- post.content.replace(/\n/g, '<br>') %></div>
    </article>

    <a href="/posts" class="btn">Volver al Inicio</a>
    <a href="/posts/<%= post.id %>/edit" class="btn">Editar</a>
    <form action="/posts/<%= post.id %>?_method=DELETE" method="POST" style="display: inline;">
        <button type="submit" class="btn btn-danger">Eliminar</button>
    </form>
</div>

<%- include('../partials/footer') %>

<style>
    .btn {
        display: inline-block;
        padding: 10px 20px;
        background: #333;
        color: #fff;
        text-decoration: none;
        border-radius: 5px;
        border: none;
        cursor: pointer;
        margin-top: 1rem;
    }
    .btn-danger {
        background: #dc3545;
    }
</style>
